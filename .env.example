# neon deploy obtiene las URLs. El secreto de cookies lo genera la aplicación.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Correos verificados de residentes autorizados para la única vivienda (separados por coma).
RESIDENT_EMAILS=
# Administradores de arranque: pueden gestionar nuevos residentes desde el panel.
RESIDENT_ADMIN_EMAILS=
# URL pública HTTPS estable, sin slash final.
APP_URL=http://localhost:3000
# Neon: Connect -> Connection pooling activado -> copiar la URL completa.
# Ejemplo (no es una credencial real):
# postgresql://usuario:password@ep-proyecto-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Solo backend: nunca usar NEXT_PUBLIC_DATABASE_URL.
# Vacío mantiene PostgreSQL embebido local; en Vercel es obligatorio Neon/PostgreSQL externo.
DATABASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@example.com
