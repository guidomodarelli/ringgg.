# Desarrollo local: copiá este archivo a .env.local con los datos de la rama Neon `dev` (nunca `production`).
# Next.js y los scripts leen .env y después .env.local, que tiene prioridad.
# neon deploy obtiene las URLs. El secreto de cookies lo genera la aplicación (32 caracteres o más).
NEON_BRANCH=dev
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
# Mantener managed hasta finalizar la migración y validar Google One Tap.
AUTH_PROVIDER=managed
# Solo para autenticación autogestionada, en un esquema separado de neon_auth.
SELF_AUTH_DATABASE_URL=
SELF_AUTH_SECRET=
SELF_AUTH_SCHEMA=ringgg_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correos de arranque, separados por coma. Los dos dan el mismo acceso compartido; el resto se autoriza desde el panel.
RESIDENT_EMAILS=
RESIDENT_ADMIN_EMAILS=
# URL pública HTTPS estable, sin slash final. En previews de Vercel se deriva sola si no se define.
APP_URL=http://localhost:3000
# Neon: Connect -> Connection pooling activado -> copiar la URL completa.
# Ejemplo (no es una credencial real):
# postgresql://usuario:password@ep-proyecto-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Solo backend: nunca usar NEXT_PUBLIC_DATABASE_URL.
# Vacío mantiene PostgreSQL embebido local; en Vercel es obligatorio Neon/PostgreSQL externo.
DATABASE_URL=
# Par propio de cada entorno (npx web-push generate-vapid-keys). Vacío en local genera uno temporal.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto real para los proveedores de push (mailto: o https://).
VAPID_SUBJECT=mailto:tu-email@example.com
# Opcional: correo de contacto que muestra /privacidad para pedir la baja o una copia de los datos.
PRIVACY_CONTACT_EMAIL=
# Solo producción: Vercel Cron lo envía a /api/cron/purge. Al menos 16 caracteres aleatorios.
CRON_SECRET=
# Opcional: chat con la visita (Worker de Cloudflare en chat/, ver docs/chat.md). Sin las dos, queda la nota.
# Local: ws://localhost:8787 con `npm run chat:dev`. Desplegado: wss://ringgg-chat.<tu-cuenta>.workers.dev
CHAT_URL=
# El mismo secreto que el Worker (chat/.dev.vars en local, `wrangler secret put` desplegado). Al menos 32 caracteres.
CHAT_SECRET=
# Opcional: cuenta sintética verificada de la rama Neon `ci` para los E2E con login real.
E2E_NEON_AUTH_EMAIL=
E2E_NEON_AUTH_PASSWORD=
E2E_NEON_AUTH_BASE_URL=
