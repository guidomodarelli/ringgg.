{
  "name": "ringgg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "better-auth": "1.7.14",
    "@better-auth/core": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "better-call": "1.4.4",
    "@better-fetch/fetch": "1.3.3",
    "zod": "$zod"
  },
  "type": "module",
  "scripts": {
    "build:sw": "node --import=tsx scripts/build-service-worker.ts",
    "predev": "npm run build:sw",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run build:sw",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "bun check --no-script && bun check --no-script -p src/service-worker",
    "typecheck:build": "tsc --noEmit && tsc --noEmit -p src/service-worker",
    "lint": "golfo-lint lint",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:e2e": "playwright test",
    "test:neon": "playwright test --config playwright.neon.config.ts",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx scripts/check-database.ts",
    "auth:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx scripts/check-auth.ts",
    "auth:prepare": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx scripts/prepare-self-auth.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@neondatabase/auth": "^0.7.0-beta",
    "@vercel/functions": "^3.10.5",
    "better-auth": "1.7.14",
    "kysely": "^0.29.7",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@golfo/lint": "0.3.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "nock": "^15.0.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
